        Include="BatshitTechnology.Core\BatshitTechnology.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Harmony, for the Showcases main-menu button only (the mod's one
         patch; docs/SHOWCASE-API.md). Compile-time only: runtime assets
         are excluded, so 0Harmony.dll is never copied to Assemblies/. The
         Harmony mod (brrainz.harmony, a declared dependency) supplies it
         at run time. 2.4.3 matches that mod's 1.6 build. -->
    <PackageReference Include="Lib.Harmony" Version="2.4.3">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <!-- Mod assets linked in so Visual Studio shows the whole mod tree. -->
  <ItemGroup>
    <None Include="..\About\**\*.*">
      <Link>About\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Include="..\Defs\**\*.*">
      <Link>Defs\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Include="..\Languages\**\*.*">
      <Link>Languages\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Include="..\Patches\**\*.*">
      <Link>Patches\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Include="..\Textures\**\*.*">
      <Link>Textures\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Include="..\Tools\**\*.*">
      <Link>Tools\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Include="..\docs\**\*.*">
      <Link>docs\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Include="..\AGENTS.md">
      <Link>AGENTS.md</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Include="..\README.md">
      <Link>README.md</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Include="..\.gitignore">
      <Link>.gitignore</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="CheckRimWorldDir"
          BeforeTargets="ResolveAssemblyReferences"
          Condition="!Exists('$(RimWorldManaged)\Assembly-CSharp.dll')">
    <Error Text="RimWorld not found at '$(RIMWORLD_DIR)'. Set the
RIMWORLD_DIR environment variable to your RimWorld install folder." />
  </Target>
  <!-- Validates every Def against the game and the assembly just built
       (Tools\validate-defs.ps1, Windows PowerShell 5.1, a few seconds).
       In RimWorld 1.6 an unresolvable Class= drops the whole Def at load,
       so a problem fails the build. Skip with -p:SkipDefValidation=true. -->
  <Target Name="ValidateDefs"
          AfterTargets="Build"
          Condition="'$(SkipDefValidation)' != 'true' And '$(OS)' == 'Windows_NT'">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\Tools\validate-defs.ps1&quot; -RimWorld &quot;$(RIMWORLD_DIR)&quot; -Assembly &quot;$(TargetPath)&quot; -MSBuild"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="ValidateDefsExitCode" />
    </Exec>
    <Error Condition="'$(ValidateDefsExitCode)' != '0'"
           Text="Def validation failed (Tools\validate-defs.ps1); see the errors above. Skip once with -p:SkipDefValidation=true." />
  </Target>
</Project>
