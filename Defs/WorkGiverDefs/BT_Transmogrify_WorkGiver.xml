<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Lets crafters work bills at the Batshittium Transmogrifier (same shape as vanilla's DoBillsStonecut) -->
  <WorkGiverDef>
    <defName>BT_DoBillsTransmogrify</defName>
    <label>transmogrify rock chunks</label>
    <giverClass>WorkGiver_DoBill</giverClass>
    <workType>Crafting</workType>
    <priorityInType>85</priorityInType>
    <fixedBillGiverDefs>
      <li>BT_BatshittiumTransmogrifier</li>
    </fixedBillGiverDefs>
    <verb>transmogrify rock at</verb>
    <gerund>transmogrifying rock at</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>
</Defs>
