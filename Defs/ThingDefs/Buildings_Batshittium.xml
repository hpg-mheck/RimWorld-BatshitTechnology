<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Batshittium Transmogrifier: powered work table; one bill turns 10 rock chunks into 1 batshittium -->
  <ThingDef ParentName="BenchBase">
    <defName>BT_BatshittiumTransmogrifier</defName>
    <label>batshittium transmogrifier</label>
    <description>A humming machine that transmogrifies ordinary rock chunks into batshittium, ten chunks to one unit. Nobody is entirely sure where the rest goes.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/BT_BatshittiumTransmogrifier</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <costList>
      <Steel>150</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <statBases>
      <WorkToBuild>3000</WorkToBuild>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <Beauty>-4</Beauty>
      <Mass>40</Mass>
    </statBases>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>1</fillPercent> <!-- impassable: must block shots fully -->
    <size>(2,2)</size>
    <passability>Impassable</passability>
    <designationCategory>Production</designationCategory>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>300</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <!-- Destroyed by damage: spews its hopper across the area -->
      <li Class="BatshitTechnology.CompProperties_DeathBlast">
        <radius>4.9</radius>
        <blast Class="BatshitTechnology.Detonation_HopperBurst">
          <damageDef>BombSuper</damageDef>
          <damage>35</damage>
          <chunks>6~10</chunks>
          <batshittium>1~3</batshittium>
          <throwRadius>8</throwRadius>
        </blast>
      </li>
    </comps>
    <recipes>
      <li>BT_TransmogrifyRockChunks</li>
    </recipes>
    <researchPrerequisites>
      <li>BT_Research_Transmogrifier</li>
    </researchPrerequisites>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
  </ThingDef>

  <!-- Batshittium Reactor: 250,000 W while one unit of batshittium burns (0.1-36 in-game hours, at random).
       Dumps a huge amount of waste heat into every room within 12 tiles, so build it away from housing. -->
  <ThingDef ParentName="BuildingBase">
    <defName>BT_BatshittiumReactor</defName>
    <label>batshittium reactor</label>
    <description>Burns one unit of batshittium at a time to produce 250,000 W. Each unit lasts anywhere from a few minutes to a day and a half, and nobody can predict which. Haulers keep it loaded.\n\nIt sheds an enormous amount of waste heat into every room within 12 tiles, inside or out. Build it well away from anywhere people live.\n\nIt can self-destruct: a core blast, then three full Ballista volleys flung in every direction. Damage can set it off.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Power/BT_BatshittiumReactor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent> <!-- impassable: must block shots fully -->
    <castEdgeShadows>true</castEdgeShadows>
    <tickerType>Normal</tickerType>
    <designationCategory>Power</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories> <!-- minifiable buildings need one -->
      <li>BuildingsPower</li>
    </thingCategories>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <costList>
      <Steel>250</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <statBases>
      <WorkToBuild>8000</WorkToBuild>
      <MaxHitPoints>500</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>-20</Beauty>
      <Mass>80</Mass>
    </statBases>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlant</compClass>
        <basePowerConsumption>-250000</basePowerConsumption> <!-- negative = output -->
        <transmitsPower>true</transmitsPower>
        <soundAmbientProducingPower>ChemfuelFiredGenerator_Ambience</soundAmbientProducingPower>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Refuelable">
        <!-- One unit burns while a second waits loaded, so supply never gaps. The reactor comp spends
             each unit when its burn ends, so vanilla's per-tick consumption is off. -->
        <fuelCapacity>2</fuelCapacity>
        <fuelConsumptionRate>0</fuelConsumptionRate>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <autoRefuelPercent>0.5</autoRefuelPercent>
        <fuelFilter>
          <thingDefs>
            <li>BT_Batshittium</li>
          </thingDefs>
        </fuelFilter>
        <fuelLabel>Batshittium</fuelLabel>
        <fuelGizmoLabel>Batshittium</fuelGizmoLabel>
        <outOfFuelMessage>Needs batshittium</outOfFuelMessage>
        <fuelIconPath>Things/Item/Resource/BT_Batshittium</fuelIconPath>
        <showFuelGizmo>true</showFuelGizmo>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
      <li Class="CompProperties_Glower"> <!-- lit while fueled and switched on -->
        <glowRadius>8</glowRadius>
        <glowColor>(217,64,255,0)</glowColor>
      </li>
      <li Class="BatshitTechnology.CompProperties_BatshittiumReactor">
        <burnHoursRange>0.1~36</burnHoursRange> <!-- in-game hours per unit -->
        <heatPerSecond>1000</heatPerSecond> <!-- a vanilla heater pushes 21 -->
        <heatRadius>12</heatRadius>
        <heatMaxTemperature>200</heatMaxTemperature> <!-- °C; things auto-ignite above 240 -->
      </li>
      <!-- Self-destruct: last comp, so nothing ticks after it blows -->
      <li Class="BatshitTechnology.CompProperties_SelfDestruct">
        <armingTicks>180</armingTicks> <!-- 3 seconds of pawn work -->
        <countdownSeconds>10</countdownSeconds>
        <finalWarningSeconds>3</finalWarningSeconds> <!-- warning turns red and fast -->
        <fleeRadius>30</fleeRadius>
        <blastRadius>70</blastRadius> <!-- how far the bolts reach -->
        <damageTriggerChance>0.05</damageTriggerChance> <!-- per damaging hit -->
        <damageSkipCountdownChance>0.5</damageSkipCountdownChance>
        <!-- A core blast, then three full Ballista volleys at once in every
             direction. Farther targets take longer to reach, so the impacts
             spread outward as a wave. -->
        <detonation Class="BatshitTechnology.Detonation_BoltBarrage">
          <projectile>BT_Projectile_BoltReallyPainful</projectile>
          <volleys>3</volleys>
          <boltsPerVolley>256</boltsPerVolley>
          <volleyIntervalTicks>30</volleyIntervalTicks>
          <innerRadius>4</innerRadius>
          <coreDamageDef>BombSuper</coreDamageDef>
          <coreRadius>7.9</coreRadius>
          <coreDamage>150</coreDamage>
        </detonation>
      </li>
    </comps>
    <placeWorkers>
      <li>BatshitTechnology.PlaceWorker_ShowReactorHeatRadius</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>BT_Research_Reactor</li>
    </researchPrerequisites>
  </ThingDef>
</Defs>
