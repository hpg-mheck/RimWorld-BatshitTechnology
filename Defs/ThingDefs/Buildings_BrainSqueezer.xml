<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Brain Squeezer: a powered chair colonists sit in for recreation. Its
       joy giver, job, memory and hediff are in Misc/BT_BrainSqueezer.xml. -->
  <ThingDef ParentName="BuildingBase">
    <defName>BT_BrainSqueezer</defName>
    <label>brain squeezer</label>
    <description>A padded chair under a humming, articulated headpiece that gently squeezes the brain of whoever sits in it. A session gives moderate recreation, a day of calm (a lower mental break threshold, so fewer breakdowns, riots and arguments) and a lingering sense that something was rearranged.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Joy/BT_BrainSqueezer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.3,1.3)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <rotatable>true</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.4</fillPercent>
    <designationCategory>Joy</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsJoy</li>
    </thingCategories>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
      <BT_Batshittium>1</BT_Batshittium>
    </costList>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>2500</WorkToBuild>
      <Mass>20</Mass>
      <Flammability>0.6</Flammability>
      <Beauty>-1</Beauty>
      <Comfort>0.6</Comfort>
      <JoyGainFactor>1</JoyGainFactor> <!-- moderate, like a tube television -->
    </statBases>
    <building>
      <isSittable>true</isSittable>
      <joyKind>BT_BrainSqueezing</joyKind>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>150</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <!-- Destroyed by damage: squeezes every brain nearby -->
      <li Class="BatshitTechnology.CompProperties_DeathBlast">
        <radius>9.9</radius> <!-- how far the squeeze reaches -->
        <blast Class="BatshitTechnology.Detonation_PsychicSqueeze">
          <stunTicks>240</stunTicks>
          <fireballRadius>2.9</fireballRadius>
        </blast>
      </li>
    </comps>
    <researchPrerequisites>
      <li>BT_Research_BrainSqueezer</li>
    </researchPrerequisites>
  </ThingDef>
</Defs>
