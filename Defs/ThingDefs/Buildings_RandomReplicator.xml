<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>RandomReplicator</defName>
    <label>random replicator</label>
    <description>
      Fabricates random food into an internal chilled queue (10). Pauses when
      full.
    </description>
    <category>Building</category>
    <designationCategory>Production</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(2, 2)</size>
    <passability>Impassable</passability>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <graphicData>
      <texPath>Things/Building/Special/InfiniteChemreactor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2, 2)</drawSize>
    </graphicData>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <statBases>
      <WorkToBuild>2200</WorkToBuild>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>0.7</Flammability>
      <Beauty>-2</Beauty>
      <Mass>25</Mass>
    </statBases>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>50</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="RandomReplicator.CompProperties_RandomReplicator">
        <ticksPerSpawn>15000</ticksPerSpawn>
        <maxNearbyStacks>10</maxNearbyStacks>
        <searchRadius>1.9</searchRadius>
        <allowedThingCategoryDefs>
          <li>FoodMeals</li>
          <li>FoodRaw</li>
        </allowedThingCategoryDefs>
        <requirePower>true</requirePower>
        <writeTimeLeftToSpawn>true</writeTimeLeftToSpawn>
        <preferInteractionCell>true</preferInteractionCell>
      </li>
    </comps>
    <tickerType>Normal</tickerType>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
  </ThingDef>
</Defs>
